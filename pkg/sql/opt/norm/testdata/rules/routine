# Regression test for #157840 - don't apply decorrelation rules targeting
# routine parameters.
exec-ddl
CREATE TABLE t (
  k INT PRIMARY KEY,
  s STRING
);
----

exec-ddl
CREATE PROCEDURE p_decorrelation(ts t[]) LANGUAGE SQL AS $$
  WITH ins AS (
    SELECT (p).k, (p).s
    FROM ROWS FROM (unnest(ts)) AS p
  )
  UPDATE t
  SET s = ins.s
  FROM ins
  WHERE t.k = ins.k
$$;
----

# The filter should remain in the join's ON condition.
