statement ok
INSERT INTO departments VALUES (5, 'Research', 180000), (6, 'Operations', 90000)

statement ok
INSERT INTO employees VALUES 
  (7, 'Research_Lead', 5, 130000),
  (8, 'Ops_Manager', 6, 100000)

# Query that uses lookup join but only accesses Research dept
# Should only need writes for dept 5 and Employee_7
query ITI rowsort
SELECT e.id, e.name, d.id
FROM employees e 
INNER LOOKUP JOIN departments d ON e.dept_id = d.id
WHERE d.name = 'Research'
----
7  Research_Lead  5

# Query mixing reads of updated and non-updated data
# Should get updated budgets for depts 1,2,3 and original budget for dept 10
query ITR rowsort
SELECT d.id, d.name, d.budget
FROM departments d
WHERE d.id IN (1, 2, 10)
----
1   Engineering  220000.0
2   Sales        165000.0
10  Legal        50000

statement ok
COMMIT

