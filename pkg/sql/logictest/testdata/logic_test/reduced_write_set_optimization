# Test Case 1: Transaction with mutations to multiple tables,
# followed by a lookup join that only reads a subset of the mutated data
statement ok
BEGIN

# Add new departments and employees (creates writes to many keys)
statement ok
INSERT INTO departments VALUES 
  (1, 'Engineering', 200000),
  (2, 'Sales', 150000),
  (3, 'Marketing', 120000),
  (4, 'Support', 80000)

statement ok
INSERT INTO employees VALUES 
  (1, 'John_Doe', 1, 120000),
  (2, 'Jane_Smith', 1, 110000),
  (3, 'Mike_Wilson', 2, 95000),
  (4, 'Sarah_Brown', 2, 85000),
  (5, 'Tom_Jones', 3, 75000),
  (6, 'Lisa_Wang', 4, 70000)

statement ok
INSERT INTO projects VALUES 
  (1, 'Database_Migration', 1, 'active'),
  (2, 'API_Redesign', 1, 'planning'),
  (3, 'Sales_Dashboard', 2, 'active'),
  (4, 'Customer_Portal', 4, 'planning')

# Query that uses lookup join but only accesses Engineering dept (id=1)
# This should only need writes for dept 1, employees 1&2, and project 1&2
# The streamer should receive a reduced write set, not all the mutations
query ITIT rowsort
SELECT e.id, e.name, p.id, p.name
FROM employees e 
INNER LOOKUP JOIN departments d ON e.dept_id = d.id 
INNER LOOKUP JOIN projects p ON p.dept_id = d.id
WHERE d.name = 'Engineering'
----
1  John_Doe   1  Database_Migration
1  John_Doe   2  API_Redesign
2  Jane_Smith 1  Database_Migration
2  Jane_Smith 2  API_Redesign

# Query that reads both mutated and existing data
# Should include existing Legal dept data and new Engineering data
query IT rowsort
SELECT d.id, d.name
FROM departments d
WHERE d.id IN (1, 10)
----
1   Engineering
10  Legal

# Query that only reads existing (non-mutated) data
# Should not need any writes from this transaction
query IT rowsort
SELECT e.id, e.name
FROM employees e
WHERE e.id >= 100
----
100  Alice_Johnson
200  Bob_Smith
300  Carol_Davis

statement ok
COMMIT

# Test Case 2: Large write set with selective index join
statement ok
BEGIN

# Insert many rows to create a large write set
statement ok
INSERT INTO employees 
SELECT 
  1000 + i, 
  'Employee_' || i, 
  CASE WHEN i % 4 = 0 THEN 1 
       WHEN i % 4 = 1 THEN 2
       WHEN i % 4 = 2 THEN 3
       ELSE 4 END,
  50000 + i * 1000
FROM generate_series(1, 100) i

# Query with index join that only needs a small subset
# Should only send writes for employees with names containing 'Employee_1'
query IT rowsort
SELECT e.id, e.name
FROM employees e
WHERE e.name LIKE 'Employee_1%'
ORDER BY e.id
LIMIT 5
----
1001  Employee_1
1010  Employee_10
1011  Employee_11
1012  Employee_12
1013  Employee_13

statement ok
COMMIT

# Test Case 3: Multi-department transaction with foreign key lookups
statement ok
BEGIN

# Update existing departments and add new ones
statement ok
