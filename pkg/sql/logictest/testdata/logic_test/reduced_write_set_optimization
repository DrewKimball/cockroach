# Logic test for reduced write set optimization in leaf transactions.
# This test verifies that when a transaction performs mutations followed by
# read-only operations using parallel execution (streamer), the leaf transactions
# only receive writes for keys that are actually being read, not the entire
# write set.

statement ok
CREATE TABLE departments (
  id INT PRIMARY KEY,
  name STRING NOT NULL,
  budget DECIMAL,
  INDEX name_idx (name)
)

statement ok
CREATE TABLE employees (
  id INT PRIMARY KEY,
  name STRING NOT NULL,
  dept_id INT NOT NULL,
  salary DECIMAL,
  INDEX dept_idx (dept_id),
  INDEX name_idx (name)
)

statement ok
CREATE TABLE projects (
  id INT PRIMARY KEY,
  name STRING NOT NULL,
  dept_id INT NOT NULL,
  status STRING DEFAULT 'active',
  INDEX dept_idx (dept_id),
  INDEX status_idx (status)
)

# Insert some existing data before the transaction
statement ok
INSERT INTO departments VALUES 
  (10, 'Legal', 50000),
  (20, 'HR', 75000),
  (30, 'Finance', 100000)

statement ok
INSERT INTO employees VALUES 
  (100, 'Alice_Johnson', 10, 80000),
